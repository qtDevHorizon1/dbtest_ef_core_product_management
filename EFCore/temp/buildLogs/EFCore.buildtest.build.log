mal minPrice, decimal maxPrice)\\n+        {\\n+            return await context.Products\\n+                .Include(p => p.Category)\\n+                .Where(p => p.Price >= minPrice && p.Price <= maxPrice)\\n+                .OrderBy(p => p.Price)\\n+                .ToListAsync();\\n+        }\\n+\\n+        // Get supplier performance (number of products supplied)\\n+        public static async Task<List<Supplier>> GetSupplierPerformance(ApplicationDbContext context)\\n+        {\\n+            return await context.Suppliers\\n+                .Include(s => s.Products)\\n+                .OrderByDescending(s => s.Products.Count)\\n+                .ToListAsync();\\n+        }\\n+\\n+        // Get category statistics (number of products per category)\\n+        public static async Task<List<Category>> GetCategoryStatistics(ApplicationDbContext context)\\n+        {\\n+            return await context.Categories\\n+                .Include(c => c.Products)\\n+                .OrderByDescending(c => c.Products.Count)\\n+                .ToListAsync();\\n+        }\\n+    }\\n } \\n\\\\ No newline at end of file\\n\"}],\"system\":\"You are an experienced C# expert who creates great customer documentation on C# code migration.\\n                Assume that the input will always be about a modernization of C# code to .NET Core\\n                Remember before generating the response:\\n                    - Avoid filler words and sentences like 'This is a significant architectural change' or 'brings several benefit'.\\n                    - Do not add any recommendations like 'This migration will require significant changes'.\\n                    - Be strictly limited to IT-related topics\\n                    - Provide original, copyright-free code examples\\n                    - Use technical language appropriate for developers\\n                    - Decline queries non related to aspects of IT (Information Technology)\\n                    - Follow code form