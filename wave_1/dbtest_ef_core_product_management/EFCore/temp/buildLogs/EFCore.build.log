ng functionality while modernizing the codebase structure and dependencies for .NET 8.0 compatibility.\"}]}","model":"CLAUDE_3_7_SONNET_20250219_V1_0","temperature":0.5,"dryRun":false,"jobId":"049c66b6-8e18-48f9-99bf-3f98358e591e","guardrailOptions":[{"charOffSetStart":0,"charOffSetEnd":1749,"messageIndex":0}]}
